{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenGrok",
  "version": "0.1.0",
  "identifier": "local.opengrok.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "OpenGrok", "width": 1100, "height": 760 }],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "targets": ["dmg", "app"] }
}
