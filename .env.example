# Variable names only. Never commit real values. Put real values in your shell env
# or macOS Keychain (see docs/phase0-dev-env.md).

# FastClaw gateway (app integration uses /v1/* only)
FASTCLAW_BASE_URL=
FASTCLAW_API_KEY=
FASTCLAW_HOME=
FASTCLAW_PORT=
FASTCLAW_BIND=
FASTCLAW_SANDBOX_ENFORCE=
FASTCLAW_SANDBOX_BACKEND=
FASTCLAW_LOG_LEVEL=

# Model providers (bring your own key; set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=

# Task manager
OPENGROK_TASK_DB_PATH=
OPENGROK_ARTIFACTS_DIR=
OPENGROK_TIMEZONE=
OPENGROK_MAX_WORKER_SLOTS=

# Channels (stage 4)
TELEGRAM_BOT_TOKEN=
