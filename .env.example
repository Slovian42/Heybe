# Variable names only. Never commit real values. Put real values in your shell env
# or macOS Keychain (see docs/phase0-dev-env.md).

# FastClaw gateway process (see docs/phase0-dev-env.md). Not read by the adapter.
FASTCLAW_BASE_URL=
FASTCLAW_API_KEY=

# packages/fastclaw-adapter. Names only — never put a real token here.
# Sent as Authorization: Bearer. The client must not log this value.
# Two separate keys (see docs/t044-agent-boundary.md §2):
#   CHAT_TOKEN  — /v1/chat/completions only. Not the owner key; prefer a type=agent key
#                 created in the FastClaw console so the server refuses agent create/delete.
#   ADMIN_TOKEN — owner key, used only by the task manager to create/delete Agents.
#   The two must differ. HEYBE_FASTCLAW_TOKEN is a deprecated alias for CHAT_TOKEN.
#   END_USER    — X-Fastclaw-End-User sent on chat and file download (default heybe-local).
HEYBE_FASTCLAW_BASE_URL=
HEYBE_FASTCLAW_CHAT_TOKEN=
HEYBE_FASTCLAW_ADMIN_TOKEN=
HEYBE_FASTCLAW_END_USER=
FASTCLAW_HOME=
FASTCLAW_PORT=
FASTCLAW_BIND=
FASTCLAW_SANDBOX_ENFORCE=
FASTCLAW_SANDBOX_BACKEND=
FASTCLAW_LOG_LEVEL=

# Model providers (bring your own key; set only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_HOST=

# Task manager
HEYBE_TASK_DB_PATH=
HEYBE_ARTIFACTS_DIR=
HEYBE_TIMEZONE=
HEYBE_MAX_WORKER_SLOTS=

# Channels (stage 4)
TELEGRAM_BOT_TOKEN=
